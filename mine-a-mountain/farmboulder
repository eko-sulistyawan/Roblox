local rootPart
local function bindCharacter(character)
	if not character then rootPart = nil return end
	rootPart = character:FindFirstChild("HumanoidRootPart")
end
bindCharacter(LocalPlayer.Character)
LocalPlayer.CharacterAdded:Connect(bindCharacter)

local function getRoot()
	if rootPart and rootPart.Parent then return rootPart end
	bindCharacter(LocalPlayer.Character)
	return rootPart
end

local function getAttr(inst, name)
	local ok, value = pcall(inst.GetAttribute, inst, name)
	return ok and value or nil
end

local function formatDistance(studs)
	studs = tonumber(studs) or 0
	if studs >= 1000 then return string.format("%.1fkm", studs / 1000) end
	return string.format("%dm", math.floor(studs + 0.5))
end

-- 1. Boulder ESP (Warna Beda: Rimeveil = Ungu Terang, Nocturnite = Pink Magenta Mewah)
local boulderEspActive = true
local boulderCache = {}
local BOULDER_TARGETS = {
	Rimeveil = { rarity = "Epic", color = Color3.fromRGB(190, 120, 255) },
	Nocturnite = { rarity = "Legendary", color = Color3.fromRGB(255, 100, 220) },
}

RunService.Heartbeat:Connect(function()
	if not boulderEspActive then
		for _, entry in pairs(boulderCache) do if entry.gui then entry.gui:Destroy() end end
		boulderCache = {}
		return
	end

	local root = getRoot()
	local origin = root and root.Position or Vector3.zero
	local seen = {}

	local decorations = Workspace:FindFirstChild("MountainDecorations")
	local bouldersFolder = decorations and decorations:FindFirstChild("Boulders")

	if bouldersFolder then
		local function anchorPart(inst)
			if inst:IsA("BasePart") then return inst end
			if inst:IsA("Model") then return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart") end
			return nil
		end

		for _, child in ipairs(bouldersFolder:GetChildren()) do
			for kind, info in pairs(BOULDER_TARGETS) do
				if child.Name:find(kind, 1, true) then
					local anchor = anchorPart(child)
					if anchor then
						seen[child] = true
						local entry = boulderCache[child]

						if not entry then
							local billboard = Instance.new("BillboardGui")
							billboard.Name = "BoulderEsp"
							billboard.Adornee = anchor
							billboard.AlwaysOnTop = true
							billboard.Size = UDim2.fromOffset(150, 40)
							billboard.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
							billboard.Parent = EspHolder

							local l1 = newLabel("Title", billboard, 0, 2, info.color)
							local l2 = newLabel("Dist", billboard, 1, 2, Color3.fromRGB(240, 240, 240))
							entry = { gui = billboard, title = l1, dist = l2 }
							boulderCache[child] = entry
						end

						entry.title.Text = "[" .. info.rarity .. "] " .. kind
						local dist = (anchor.Position - origin).Magnitude
						entry.dist.Text = formatDistance(dist)
					end
				end
			end
		end
	end

	for model, entry in pairs(boulderCache) do
		if not seen[model] then
			if entry.gui then entry.gui:Destroy() end
			boulderCache[model] = nil
		end
	end
end)

