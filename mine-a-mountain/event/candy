-- ==========================================
-- 3. EXPANDED AUTO COLLECT CANDY (RECURSIVE SEARCH)
-- ==========================================
local blacklistedCandies = {}

-- Fungsi untuk mengambil seluruh permen di dalam folder utama DAN sub-foldernya (Area Diperluas)
local function getAllCandies()
    local list = {}
    local mainFolder = workspace:FindFirstChild(CANDY_FOLDER_NAME)
    
    if not mainFolder then
        -- Mencari alternatif jika nama folder persis tidak ketemu tapi ada yg mirip
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Folder") and obj.Name:lower():find("candy") then
                mainFolder = obj
                break
            end
        end
    end

    if mainFolder then
        -- Mengambil semua objek termasuk di dalam model/sub-folder
        for _, descendant in ipairs(mainFolder:GetDescendants()) do
            if (descendant:IsA("BasePart") or descendant:IsA("MeshPart") or descendant:IsA("Part")) and not blacklistedCandies[descendant] then
                pcall(function() descendant.CanCollide = false end)
                table.insert(list, descendant)
            end
        end
    end
    return list, mainFolder ~= nil
end

local function getNearestCandy(fromPos)
    local candies, foundFolder = getAllCandies()
    local nearest, nearestDist = nil, math.huge
    
    for _, candy in ipairs(candies) do
        local dist = (candy.Position - fromPos).Magnitude
        if dist < nearestDist then
            nearestDist = dist
            nearest = candy
        end
    end
    return nearest, nearestDist, #candies, foundFolder
end

task.spawn(function()
    while not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") do
        task.wait(0.5)
    end

    local lastPos = Vector3.new(0, 0, 0)
    local stuckTimer = 0
    local currentTarget = nil

    while true do
        if isCandyRunning then
            pcall(function()
                local character = LocalPlayer.Character
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")

                if rootPart then
                    local playerPos = rootPart.Position

                    -- Anti-Stuck Detector
                    if (playerPos - lastPos).Magnitude < 1 then
                        stuckTimer = stuckTimer + TELEPORT_INTERVAL
                        if stuckTimer >= 1.5 then
                            if currentTarget then
                                blacklistedCandies[currentTarget] = true
                                task.delay(5, function() blacklistedCandies[currentTarget] = nil end)
                            end
                            if humanoid then
                                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                            end
                            rootPart.CFrame = rootPart.CFrame + Vector3.new(math.random(-8, 8), 4, math.random(-8, 8))
                            stuckTimer = 0
                        end
                    else
                        stuckTimer = 0
                        lastPos = playerPos
                    end

                    local candy, dist = getNearestCandy(playerPos)
                    currentTarget = candy

                    if candy and dist > COLLECT_RADIUS then
                        local targetPos = candy.Position + Vector3.new(0, CANDY_OFFSET_Y, 0)
                        rootPart.CFrame = CFrame.new(targetPos)
                        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                end
            end)
        end
        task.wait(TELEPORT_INTERVAL)
    end
end)

