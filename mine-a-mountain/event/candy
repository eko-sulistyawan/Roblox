-- 4. SMART AUTO HOP & LIVE STATUS UPDATER
-- ==========================================
local function serverHop(reason)
    pcall(function()
        notify("Auto Hop", reason)
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if success and result and result.data then
            local servers = {}
            for _, server in ipairs(result.data) do
                if type(server) == "table" and server.playing and server.maxPlayers and server.playing < server.maxPlayers and server.id ~= game.JobId then
                    table.insert(servers, server.id)
                end
            end

            if #servers > 0 then
                local targetServer = servers[math.random(1, #servers)]
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, LocalPlayer)
                return
            end
        end
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
end

task.spawn(function()
    while not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") do
        task.wait(0.5)
    end

    local lastHopTime = os.time()
    local noCandyTimer = 0

    while true do
        task.wait(1)

        local _, _, totalCandies, folderExists = getNearestCandy(Vector3.new(0,0,0))
        local timeLimitSeconds = hopIntervalMinutes * 60
        local elapsed = os.time() - lastHopTime
        local remainingSec = math.max(0, timeLimitSeconds - elapsed)
        local remMin = math.floor(remainingSec / 60)
        local remSec = remainingSec % 60

        -- Update Status Teks Live di UI
        local candyInfoStr = folderExists and tostring(totalCandies) .. " item" or "Folder Tidak Ketemu!"
        local hopStatusStr = isHopRunning and string.format("Aktif (%02d:%02d tersisa)", remMin, remSec) or "Dimatikan"
        StatusText.Text = string.format("<b>STATUS INFORMASI:</b>\n• Candy Terdeteksi: <b>%s</b>\n• Sisa Waktu Hop: <b>%s</b>\n• Tanpa Candy: <b>%ds / 10s</b>\n• Status Auto Hop: <b>%s</b>", candyInfoStr, hopStatusStr, noCandyTimer, isHopRunning and "Jalan" > "OFF")

        if isHopRunning then
            -- Cek apakah ada candy
            if totalCandies > 0 then
                noCandyTimer = 0
            else
                noCandyTimer = noCandyTimer + 1
            end

            -- Kondisi 1: 10 detik tanpa candy sama sekali -> Auto Hop
            if noCandyTimer >= noCandyHopSeconds then
                serverHop("10 detik tanpa candy, pindah server...")
                break
            end

            -- Kondisi 2: Berdasarkan interval waktu input menit
            if elapsed >= timeLimitSeconds then
                serverHop("Waktu habis (" .. hopIntervalMinutes .. " menit), pindah server...")
                break
            end
        else
            lastHopTime = os.time()
            noCandyTimer = 0
        end
    end
end)

