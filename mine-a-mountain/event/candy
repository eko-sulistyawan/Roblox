                    hum.Health = hum.MaxHealth
                end
            end
        end
    end
end)

-- --------------------------------------------------------
-- OPTIMIZED CANDY DETECTOR & BLACKLIST SYSTEM
-- --------------------------------------------------------
local function FindNearestCandy()
    local nearest = nil
    local shortestDistance = math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local hrp = char.HumanoidRootPart

    for _, obj in pairs(Workspace:GetDescendants()) do
        -- Cek apakah objek sudah diblacklist (gagal diambil sebelumnya)
        if not CandyBlacklist[obj] then
            local objName = string.lower(obj.Name)
            if string.find(objName, "candy") or string.find(objName, "permen") or string.find(objName, "sweet") then
                local targetPart = nil
                if obj:IsA("BasePart") then
                    targetPart = obj
                elseif obj:IsA("Model") then
                    targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                end
                
                if targetPart then
                    local dist = (hrp.Position - targetPart.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        nearest = targetPart
                    end
                end
            end
        end
    end
    return nearest
end

-- Main Farming Loop
task.spawn(function()
    while true do
        task.wait(0.1)
        
        if Settings.AutoCollect and not IsTweening then
            local candy = FindNearestCandy()
            local char = LocalPlayer.Character
            
            if candy and char and char:FindFirstChild("HumanoidRootPart") then
                LastCandyFoundTime = tick() -- Reset timer 15 detik
                
                local hrp = char.HumanoidRootPart
                local distance = (hrp.Position - candy.Position).Magnitude
                local travelTime = distance / Settings.TweenSpeed
                
                IsTweening = true
                StatusLabel.Text = "Status: Collecting Candy (Smooth)..."
                
                local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
                local tween = TweenService:Create(hrp, tweenInfo, {CFrame = candy.CFrame + Vector3.new(0, 2, 0)})
                
                tween:Play()
                
                local startTime = tick()
                local reached = false
                
                local connection
                connection = RunService.RenderStepped:Connect(function()
                    if not candy.Parent or not char:FindFirstChild("HumanoidRootPart") then
                        tween:Cancel()
                        if connection then connection:Disconnect() end
                    elseif (hrp.Position - candy.Position).Magnitude < 5 then
                        reached = true
                        tween:Cancel()
                        if connection then connection:Disconnect() end
                    elseif tick() - startTime > (travelTime + 2) then
                        -- Jika terlalu lama / stuck di tengah jalan
                        tween:Cancel()
                        if connection then connection:Disconnect() end
                    end
                end)
                
                tween.Completed:Wait()
                if connection then connection:Disconnect() end
                
                -- Jika permen masih ada tapi tidak keserap, masukkan ke blacklist sementara
                if candy.Parent then
                    task.spawn(function()
                        local parentObj = candy.Parent
                        local oldPos = candy.Position
                        task.wait(1.5)
                        -- Kalau posisinya tidak berubah (berarti tidak terambil / nyangkut), masukkan blacklist
                        if candy.Parent and (candy.Position - oldPos).Magnitude < 1 then
                            CandyBlacklist[parentObj] = true
                            -- Hapus dari blacklist setelah 10 detik barangkali bisa di-reset game
                            task.wait(10)
                            CandyBlacklist[parentObj] = nil
                        end
                    end)
                end
                
                task.wait(0.1)
                IsTweening = false
            else
                local noCandyTime = math.floor(tick() - LastCandyFoundTime)
                StatusLabel.Text = "Status: No Candy (" .. noCandyTime .. "s/15s)\nKeybind: [RCTRL] Toggle UI"
                
                -- Auto Hop jika 15 detik kosong
                if noCandyTime >= Settings.NoCandyHopDelay then
                    StatusLabel.Text = "Status: No candy for 15s. Hopping..."
                    HopServer()
                end
            end
        end
        
        -- Auto Hop Interval Server
        local timeInServer = tick() - LastServerHopTime
        if timeInServer >= Settings.ServerHopInterval then
            StatusLabel.Text = "Status: Reached interval timer. Hopping..."
            HopServer()
        end
    end
end)
