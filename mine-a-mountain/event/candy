RunService.Heartbeat:Connect(function()
    if not isAntiDamageRunning then return end
    pcall(function()
        local character = LocalPlayer.Character
        if not character then return end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end

        local velocity = rootPart.AssemblyLinearVelocity
        if velocity.Y < -MAX_FALL_SPEED then
            rootPart.AssemblyLinearVelocity = Vector3.new(velocity.X, -MAX_FALL_SPEED, velocity.Z)
        end
    end)
end)

-- ==========================================
-- 3. AUTO COLLECT CANDY (OTOMATIS JALAN SAAT START)
-- ==========================================
local blacklistedCandies = {}

local function getNearestCandy(fromPos)
    local folder = workspace:FindFirstChild(CANDY_FOLDER_NAME)
    if not folder then return nil end

    local nearest, nearestDist = nil, math.huge
    for _, candy in ipairs(folder:GetChildren()) do
        if candy:IsA("BasePart") and not blacklistedCandies[candy] then
            pcall(function() candy.CanCollide = false end)
            local dist = (candy.Position - fromPos).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = candy
            end
        end
    end
    return nearest, nearestDist
end

task.spawn(function()
    while not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") do
        task.wait(0.5)
    end

    local lastPos = Vector3.new(0, 0, 0)
    local stuckTimer = 0
    local currentTarget = nil

    while true do
        if isCandyRunning then
            pcall(function()
                local character = LocalPlayer.Character
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")

                if rootPart then
                    local playerPos = rootPart.Position

                    -- Anti-Stuck Detector
                    if (playerPos - lastPos).Magnitude < 1 then
                        stuckTimer = stuckTimer + TELEPORT_INTERVAL
                        if stuckTimer >= 1.5 then
                            if currentTarget then
                                blacklistedCandies[currentTarget] = true
                                task.delay(5, function() blacklistedCandies[currentTarget] = nil end)
                            end
                            if humanoid then
                                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                            end
                            rootPart.CFrame = rootPart.CFrame + Vector3.new(math.random(-6, 6), 3, math.random(-6, 6))
                            stuckTimer = 0
                        end
                    else
                        stuckTimer = 0
                        lastPos = playerPos
                    end

                    local candy, dist = getNearestCandy(playerPos)
                    currentTarget = candy

                    if candy and dist > COLLECT_RADIUS then
                        local targetPos = candy.Position + Vector3.new(0, CANDY_OFFSET_Y, 0)
                        rootPart.CFrame = CFrame.new(targetPos)
                        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                end
            end)
        end
        task.wait(TELEPORT_INTERVAL)
    end
end)

-- ==========================================
-- 4. AUTO HOP (10 DETIK TANPA CANDY & INTERVAL WAKTU)
-- ==========================================
local function serverHop(reason)
    pcall(function()
        notify("Auto Hop", reason)
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if success and result and result.data then
            local servers = {}
            for _, server in ipairs(result.data) do
                if type(server) == "table" and server.playing and server.maxPlayers and server.playing < server.maxPlayers and server.id ~= game.JobId then
                    table.insert(servers, server.id)
                end
            end

            if #servers > 0 then
                local targetServer = servers[math.random(1, #servers)]
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, LocalPlayer)
                return
            end
        end
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
end

task.spawn(function()
    while not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") do
        task.wait(0.5)
    end

    local lastHopTime = os.time()
    local noCandyTimer = 0

    while true do
        task.wait(1)

        if isHopRunning then
            local folder = workspace:FindFirstChild(CANDY_FOLDER_NAME)
            local hasCandy = false
            if folder then
                for _, child in ipairs(folder:GetChildren()) do
                    if child:IsA("BasePart") then
                        hasCandy = true
                        break
                    end
                end
            end

            -- Cek apakah ada candy
            if hasCandy then
                noCandyTimer = 0
            else
                noCandyTimer = noCandyTimer + 1
            end

            -- Kondisi 1: 10 detik tanpa candy -> Auto Hop
            if noCandyTimer >= noCandyHopSeconds then
                serverHop("10 detik tanpa candy, pindah server...")
                break
            end

            -- Kondisi 2: Berdasarkan interval waktu (1 s.d 120 menit)
            local currentTime = os.time()
            local intervalSeconds = hopIntervalMinutes * 60
            if (currentTime - lastHopTime) >= intervalSeconds then
                serverHop("Waktu habis (" .. hopIntervalMinutes .. " menit), pindah server...")
                break
            end
        else
            lastHopTime = os.time()
        end
    end
end)

