-- 5. SERVER HOPPER & REALTIME STATUS UPDATER
-- =================================================================
local function serverHop(reason)
    pcall(function()
        notify("Auto Hop", reason)
        
        local currentServerFriends = {}
        for _, p in ipairs(Players:GetPlayers()) do
            currentServerFriends[p.UserId] = true
        end

        local cursor = ""
        local targetServerId = nil

        for i = 1, 5 do
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then
                url = url .. "&cursor=" .. cursor
            end

            local success, result = pcall(function()
                return HttpService:JSONDecode(game:HttpGet(url))
            end)

            if success and result and result.data then
                table.sort(result.data, function(a, b)
                    return a.playing > b.playing
                end)

                for _, server in ipairs(result.data) do
                    if type(server) == "table" and server.playing and server.maxPlayers and server.id ~= game.JobId then
                        if server.playing < server.maxPlayers and server.playing > 1 then
                            targetServerId = server.id
                            break
                        end
                    end
                end
            end

            if targetServerId then break end
            if result and result.nextPageCursor then
                cursor = result.nextPageCursor
            else
                break
            end
        end

        if targetServerId then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServerId, LocalPlayer)
        else
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end
    end)
end

task.spawn(function()
    while not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") do
        task.wait(0.5)
    end

    local lastHopTime = os.time()
    local noCandyTimer = 0

    while true do
        task.wait(1)

        local _, totalCandies, folderExists = getNearestCandy(LocalPlayer.Character.HumanoidRootPart.Position)
        local timeLimitSeconds = hopIntervalMinutes * 60
        local elapsed = os.time() - lastHopTime
        local remainingSec = math.max(0, timeLimitSeconds - elapsed)

        local candyStr = folderExists and tostring(totalCandies) .. " item" or "Tidak Ada"
        
        local isActuallyHopping = isHopEnabledSetting and (totalCandies <= 50)

        local hopStr = ""
        if not isHopEnabledSetting then
            hopStr = "OFF (Manual)"
        elseif totalCandies > 50 then
            hopStr = "PAUSED (Candy > 50)"
        else
            hopStr = string.format("Aktif (%02d:%02d)", math.floor(remainingSec/60), remainingSec%60)
        end
        
        local refStr = "Aman (Farming)"
        if totalCandies > 50 then
            refStr = "🛡️ Candy Aman (> 50)"
        elseif totalCandies == 0 then
            refStr = string.format("⚠️ Kosong (%ds/%ds)", noCandyTimer, noCandyHopSeconds)
        end

        -- Format teks info menurun ke bawah dengan rapi
        StatusText.Text = string.format([[<b>STATUS SISTEM</b>
• <b>Candy</b>: %s
• <b>Auto Hop</b>: %s
• <b>Kondisi</b>: %s
• <b>Batas Kosong</b>: %ds / %ds
• <b>Auto Reconnect</b>: %s
• <b>Anti Damage</b>: %s]], 
        candyStr, 
        hopStr, 
        refStr, 
        noCandyTimer, noCandyHopSeconds, 
        isAutoReconnect and "Aktif" or "OFF", 
        isAntiDamageRunning and "Aktif" or "OFF")

        if isActuallyHopping then
            if totalCandies > 0 then
                noCandyTimer = 0
                blacklistedCandies = {}
            else
                noCandyTimer = noCandyTimer + 1
            end

            if noCandyTimer >= noCandyHopSeconds then
                serverHop("Candy kosong selama " .. noCandyHopSeconds .. " detik, pindah server...")
                break
            end

            if elapsed >= timeLimitSeconds then
                serverHop("Waktu habis (" .. hopIntervalMinutes .. "m), pindah server...")
                break
            end
        else
            lastHopTime = os.time()
            if totalCandies > 50 then
                noCandyTimer = 0
            end
        end
    end
end)

