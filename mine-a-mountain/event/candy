-- --------------------------------------------------------
-- DETEKSI CANDY DENGAN VALIDASI BATAS MAP
-- --------------------------------------------------------
local function IsRealCandy(part)
    if not part or not part:IsA("BasePart") then return false end
    
    -- Validasi agar mengabaikan permen yang nyangkut di luar map / koordinat ekstrem
    if math.abs(part.Position.X) > 5000 or math.abs(part.Position.Z) > 5000 or part.Position.Y < -500 or part.Position.Y > 2000 then
        return false
    end
    
    local hasTouch = part:FindFirstChildOfClass("TouchTransmitter") ~= nil
    local parentName = part.Parent and string.lower(part.Parent.Name) or ""
    local partName = string.lower(part.Name)
    
    local isCandyNamed = string.find(partName, "candy") or string.find(partName, "permen") or string.find(partName, "sweet") or string.find(parentName, "candy") or string.find(parentName, "permen")
    
    if (hasTouch or isCandyNamed) and not CollectedCandies[part] then
        return true
    end
    return false
end

local function FindNearestCandy()
    local nearest = nil
    local shortestDistance = math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local hrp = char.HumanoidRootPart

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and IsRealCandy(obj) then
            local dist = (hrp.Position - obj.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                nearest = obj
            end
        end
    end
    return nearest
end

-- --------------------------------------------------------
-- MAIN AUTO COLLECT LOOP (DENGAN AUTO-REFRESH CACHE)
-- --------------------------------------------------------
task.spawn(function()
    while true do
        task.wait(0.1)
        
        -- Auto-refresh cache list permen setiap 5 detik agar list tidak macet
        if tick() - LastCacheClearTime > 5 then
            CollectedCandies = {}
            LastCacheClearTime = tick()
        end
        
        if Settings.AutoCollect then
            local candy = FindNearestCandy()
            local char = LocalPlayer.Character
            
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                
                -- Jika karakter tidak sengaja jatuh atau stuck di luar map (Y < -100), reset ke tengah map
                if hrp.Position.Y < -100 then
                    hrp.CFrame = CFrame.new(0, 50, 0)
                    task.wait(0.5)
                end
            end
            
            if candy and char and char:FindFirstChild("HumanoidRootPart") then
                LastCandyFoundTime = tick() -- Reset timer 15 detik
                
                local hrp = char.HumanoidRootPart
                
                -- Teleport instan di atas permen asli
                hrp.CFrame = candy.CFrame + Vector3.new(0, 0.5, 0)
                
                -- Tandai permen ini sementara
                CollectedCandies[candy] = true
                
                pcall(function()
                    firetouchinterest(hrp, candy, 0)
                    firetouchinterest(hrp, candy, 1)
                end)
                
                StatusLabel.Text = "Status: Collecting Candy..."
                task.wait(0.2)
            else
                local noCandyTime = math.floor(tick() - LastCandyFoundTime)
                StatusLabel.Text = "Status: No Candy (" .. noCandyTime .. "s/15s)\nKeybind: [RCTRL] Toggle UI"
                
                -- Auto Hop jika 15 detik kosong
                if noCandyTime >= Settings.NoCandyHopDelay then
                    StatusLabel.Text = "Status: No candy for 15s. Hopping..."
                    HopServer()
                end
            end
        end
        
        -- Auto Hop Interval Server
        local timeInServer = tick() - LastServerHopTime
        if timeInServer >= Settings.ServerHopInterval then
            StatusLabel.Text = "Status: Reached interval timer. Hopping..."
            HopServer()
        end
    end
end)
