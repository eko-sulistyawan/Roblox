            local hopStr = ""
            if not isHopEnabledSetting then
                hopStr = "OFF (Manual)"
            elseif totalCandies >= CANDY_LIMIT_TRIGGER then
                hopStr = "PAUSED (Candy > 99)"
            else
                hopStr = string.format("Aktif (%02d:%02d)", math.floor(remainingSec/60), remainingSec%60)
            end
            
            local refStr = "Farming..."
            if not isMapLoadedReady then
                refStr = "Menunggu Render Map..."
            elseif not isCandyAndFlyRunning then
                refStr = "Auto Farm DIMATIKAN"
            elseif totalCandies >= CANDY_LIMIT_TRIGGER then
                refStr = "Candy Aman (> 99)"
            elseif totalCandies < FARM_MIN_CANDY then
                refStr = "Candy < 10 (Menunggu Hop)"
            end

            StatusText.Text = string.format([[STATUS SISTEM (PRO)
• Candy       : %s
• Auto Hop    : %s
• Kondisi     : %s
• Batas Aman  : > %d Candy
• Reconnect   : %s
• FPS Boost   : Aktif (Max)]], 
            candyStr, 
            hopStr, 
            refStr, 
            CANDY_LIMIT_TRIGGER,
            isAutoReconnect and "Aktif" or "OFF")

            if isActuallyHopping and isMapLoadedReady then
                if totalCandies > 0 then
                    blacklistedCandies = {}
                end

                if elapsed >= timeLimitSeconds then
                    serverHop("Waktu habis (" .. hopIntervalMinutes .. "m), pindah server...")
                    break
                end
            else
                lastHopTime = os.time()
            end
        end
    end
end)

