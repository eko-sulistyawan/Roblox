-- 4. SMART CANDY SCANNER & TELEPORT LOGIC
-- =================================================================
local blacklistedCandies = {}

local function getCachedCandyFolder()
    local folder = workspace:FindFirstChild(CANDY_FOLDER_NAME)
    if folder then return folder end
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Folder") and (obj.Name:lower():find("candy") or obj.Name:lower():find("drop")) then
            return obj
        end
    end
    return nil
end

local function getNearestCandy(fromPos)
    local folder = getCachedCandyFolder()
    if not folder then return nil, 0, false end

    local nearest, nearestDist = nil, math.huge
    local count = 0

    for _, child in ipairs(folder:GetChildren()) do
        if (child:IsA("BasePart") or child:IsA("Model")) and not blacklistedCandies[child] then
            local part = child:IsA("BasePart") and child or child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
            if part then
                count = count + 1
                pcall(function() part.CanCollide = false end)
                local dist = (part.Position - fromPos).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = part
                end
            end
        end
    end
    return nearest, count, true
end

task.spawn(function()
    while not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") do
        task.wait(0.5)
    end

    local lastPos = Vector3.new(0, 0, 0)
    local stuckTimer = 0
    local currentTarget = nil

    while true do
        if isCandyAndFlyRunning then
            pcall(function()
                local character = LocalPlayer.Character
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local playerPos = rootPart.Position

                    -- Smart Anti-Stuck Check
                    if (playerPos - lastPos).Magnitude < 1 then
                        stuckTimer = stuckTimer + TELEPORT_INTERVAL
                        if stuckTimer >= 1.2 then
                            if currentTarget then
                                blacklistedCandies[currentTarget] = true
                                task.delay(5, function() blacklistedCandies[currentTarget] = nil end)
                            end
                            rootPart.CFrame = rootPart.CFrame + Vector3.new(math.random(-6, 6), 6, math.random(-6, 6))
                            stuckTimer = 0
                        end
                    else
                        stuckTimer = 0
                        lastPos = playerPos
                    end

                    local candy, _, _ = getNearestCandy(playerPos)
                    currentTarget = candy

                    if candy and (candy.Position - playerPos).Magnitude > COLLECT_RADIUS then
                        rootPart.CFrame = CFrame.new(candy.Position + Vector3.new(0, CANDY_OFFSET_Y, 0))
                        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                end
            end)
        end
        task.wait(TELEPORT_INTERVAL)
    end
end)

