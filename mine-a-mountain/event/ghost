local function getNearestBoulder(models)
    if not HumanoidRootPart then return nil end
    local playerPos = HumanoidRootPart.Position
    local nearestModel, nearestDistance = nil, math.huge
    for _, model in ipairs(models) do
        if not processedBoulders[model] and model.Parent then
            local center = getBoulderCenter(model)
            if center then
                local distance = (center - playerPos).Magnitude
                if distance < nearestDistance then
                    nearestDistance = distance
                    nearestModel = model
                end
            end
        end
    end
    return nearestModel
end

local function collectCrystalsNearby(duration)
    local endTime = os.clock() + duration
    while isBoulderRunning and os.clock() < endTime do
        if not HumanoidRootPart then break end
        local playerPos = HumanoidRootPart.Position
        for _, prompt in ipairs(workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                local part = prompt.Parent
                if part and part:IsA("BasePart") then
                    local d = (part.Position - playerPos).Magnitude
                    if d <= CRYSTAL_PICKUP_RADIUS then
                        pcall(function()
                            prompt.HoldDuration = 0
                            fireproximityprompt(prompt)
                        end)
                    end
                end
            end
        end
        task.wait(0.15)
    end
end

local function processBoulder(nearestModel)
    if not nearestModel or not nearestModel.Parent then return end

    local center = getBoulderCenter(nearestModel)
    if not center then
        processedBoulders[nearestModel] = true
        task.wait(0.2)
        return
    end

    local targetPos = center + Vector3.new(0, BOULDER_OFFSET_Y, 0)
    anchorPlayer(false)
    moveToPositionB(targetPos)
    waitForArrivalB(targetPos)
    stopMovementB()
    if HumanoidRootPart then HumanoidRootPart.CFrame = CFrame.new(targetPos) end
    anchorPlayer(true); faceBackDown()
    if not isBoulderRunning then return end

    local lastHP = boulderHasHP(nearestModel)
    local hitsSinceHPChange = 0
    local cells = getBoulderCells(nearestModel)
    local currentCellIndex = 1

    while isBoulderRunning and nearestModel.Parent do
        local hp = boulderHasHP(nearestModel)
        if hp ~= nil and hp <= 0 then break end

        if hp ~= lastHP then
            lastHP = hp
            hitsSinceHPChange = 0
        else
            hitsSinceHPChange = hitsSinceHPChange + 1
        end

        if #cells == 0 or not cells[currentCellIndex]
           or not cells[currentCellIndex].Parent
           or cells[currentCellIndex].Parent ~= nearestModel then
            cells = getBoulderCells(nearestModel)
            if #cells == 0 then break end
            currentCellIndex = (currentCellIndex % #cells) + 1
            hitsSinceHPChange = 0
        end

        if hitsSinceHPChange >= HP_STALL_HITS then
            cells = getBoulderCells(nearestModel)
            if #cells > 0 then
                currentCellIndex = (currentCellIndex % #cells) + 1
            end
            hitsSinceHPChange = 0
        end

        local cell = cells[currentCellIndex]
        if not cell or not cell.Parent then
            cells = getBoulderCells(nearestModel)
            currentCellIndex = 1
            if #cells == 0 then break end
            cell = cells[currentCellIndex]
        end

        local pickaxe = getEquippedPickaxe() or "The Event Horizon"
        local args = { pickaxe, vector.create(cell.Position.X, cell.Position.Y, cell.Position.Z) }
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            local digRequest = remotes:FindFirstChild("DigRequest")
            if digRequest then
                pcall(function() digRequest:FireServer(unpack(args)) end)
            end
        end

        task.wait(BOULDER_DIG_INTERVAL)
    end

    processedBoulders[nearestModel] = true

    local modelGone = not nearestModel.Parent
    local waitTime = modelGone and 0 or CRYSTAL_PICKUP_TIME
    if waitTime > 0 then task.wait(waitTime) end
    collectCrystalsNearby(CRYSTAL_PICKUP_TIME)
end

local function boulderLoop()
    while isBoulderRunning do
        local models = getBoulderModels()
        local nearestModel = getNearestBoulder(models)

        if nearestModel and nearestModel.Parent then
            processBoulder(nearestModel)
        else
            anchorPlayer(true)
            faceBackDown()
            task.wait(BOULDER_CHECK_INTERVAL)
        end

        task.wait(0.3)
    end
    stopMovementB()
    anchorPlayer(false)
end

-- ===================== Candy =====================
local function getCandyFolder()
    return workspace:FindFirstChild(CANDY_FOLDER_NAME)
end

local function getNearestCandy(fromPos)
    local folder = getCandyFolder()
    if not folder then return nil end
    local nearest, nearestDist = nil, math.huge
    for _, candy in ipairs(folder:GetChildren()) do
        if candy:IsA("BasePart") then
            local dist = (candy.Position - fromPos).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = candy
            end
        end
    end
    return nearest, nearestDist
end

local function disableCollide(part)
    if part:IsA("BasePart") then
        part.CanCollide = false
    end
end

do
    local folder = getCandyFolder()
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
            disableCollide(child)
        end
        folder.ChildAdded:Connect(disableCollide)
    else
        workspace.ChildAdded:Connect(function(child)
            if child.Name == CANDY_FOLDER_NAME then
                for _, c in ipairs(child:GetChildren()) do
                    disableCollide(c)
                end
                child.ChildAdded:Connect(disableCollide)
            end
        end)
    end
end

local function candyLoop()
    while isCandyRunning do
        if HumanoidRootPart and HumanoidRootPart.Parent then
            local playerPos = HumanoidRootPart.Position
            local candy, dist = getNearestCandy(playerPos)

            if candy and dist > COLLECT_RADIUS then
                local targetPos = candy.Position + Vector3.new(0, CANDY_OFFSET_Y, 0)
                HumanoidRootPart.CFrame = CFrame.new(targetPos)
                HumanoidRootPart.AssemblyLinearVelocity   = Vector3.new(0, 0, 0)
                HumanoidRootPart.AssemblyAngularVelocity  = Vector3.new(0, 0, 0)
            end
        end
        task.wait(TELEPORT_INTERVAL)
    end
end

-- ===================== Anti Fall =====================
local function LimitFallSpeed()
    if not isFallRunning then return end
    local character = LocalPlayer.Character
    if not character then return end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local velocity = rootPart.AssemblyLinearVelocity
    if velocity.Y < -MAX_FALL_SPEED then
        rootPart.AssemblyLinearVelocity = Vector3.new(velocity.X, -MAX_FALL_SPEED, velocity.Z)
    end
end

function startFallLimit()
    if fallConnection then
        pcall(function() fallConnection:Disconnect() end)
        fallConnection = nil
    end
    isFallRunning = true
    fallConnection = RunService.Heartbeat:Connect(LimitFallSpeed)
end

function stopFallLimit()
    isFallRunning = false
    if fallConnection then
        pcall(function() fallConnection:Disconnect() end)
        fallConnection = nil
    end
end

