}

local function GetHealthColor(p)
    local r, g, b
    if p >= 0.5 then
        local t = (p - 0.5) * 2
        r = math.floor(255 * (1 - t))
        g = 255
        b = 0
    else
        local t = p * 2
        r = 255
        g = math.floor(255 * t)
        b = 0
    end
    return string.format("rgb(%d,%d,%d)", r, g, b)
end

local function GetTextSize(d)
    local c = math.max(10, math.min(400, d))
    return math.floor((26 - (c - 10) * (10 / 390)) * 10) / 10
end

local function GetPaddingSize(d)
    local c = math.max(10, math.min(400, d))
    return math.floor((8 - (c - 10) * (7 / 390)) * 10) / 10
end

local function CreateTextLabel(parent, name, text, order)
    local label = Instance.new("TextLabel")
    label.Parent = parent
    label.Name = name
    label.Text = text
    label.LayoutOrder = order or 0
    label.Size = UDim2.new(1, 0, 0.2, 0)
    label.BackgroundTransparency = 1
    label.BorderSizePixel = 0
    label.TextSize = 22
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    label.BorderColor3 = Color3.fromRGB(0, 0, 0)
    label.FontFace = Font.new("rbxasset://fonts/families/ComicNeueAngular.json")
    label.TextWrapped = true
    label.RichText = true
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0.5
    return label
end

local function CreateBoulderUI(boulder)
    if not boulder or not boulder:IsA("Model") then return end

    local colorData = BoulderColors[boulder.Name] or {Color3.new(0.5, 0.5, 0.5), "rgb(128,128,128)"}

    for _, part in pairs(boulder:GetChildren()) do
        if part:IsA("BasePart") then
            part.Transparency = 0
        end
    end

    local highlight = Instance.new("Highlight", boulder)
    highlight.FillColor = colorData[1]

    local gui = Instance.new("BillboardGui")
    gui.AlwaysOnTop = true
    gui.Parent = boulder
    gui.LightInfluence = 1
    gui.Active = true
    gui.Size = UDim2.new(0, 300, 0, 100)
    gui.ClipsDescendants = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.StudsOffset = Vector3.new(0, 10, 0)

    local layout = Instance.new("UIListLayout")
    layout.Parent = gui
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 2)

    local name     = boulder.Name
    local rarity   = boulder:GetAttribute("Rarity") or "Common"
    local hp       = boulder:GetAttribute("HP") or 100
    local maxHP    = boulder:GetAttribute("MaxHP") or 100
    local hex      = colorData[2]

    local hpLabel   = CreateTextLabel(gui, "HP/MaxHP",
        '<font color="'..GetHealthColor(hp/maxHP)..'">'..hp..'</font>/'..maxHP..' HP', 1)
    local nameLabel = CreateTextLabel(gui, "BoulderName",
        '<font color="'..hex..'">'..name..'</font> ('..rarity..')', 0)
    local distLabel = CreateTextLabel(gui, "Distance", "Distance: 0 Studs", 2)

    BoulderData[boulder] = {
        HP = hpLabel, Name = nameLabel, Dist = distLabel,
        Layout = layout, Highlight = highlight,
        LastHP = hp, LastMaxHP = maxHP,
        LastSize = 22, LastPad = 2,
        LastName = name, LastRarity = rarity,
    }
end

local function DestroyAllESP()
    for boulder, data in pairs(BoulderData) do
        if data.Highlight and data.Highlight.Parent then data.Highlight:Destroy() end
        if data.HP and data.HP.Parent then
            local gui = data.HP.Parent
            if gui then gui:Destroy() end
        end
    end
    BoulderData = {}
end

local function CheckForNewBoulders()
    if not ESP_ENABLED then return end

    local mountainDecorations = workspace:FindFirstChild("MountainDecorations")
    if not mountainDecorations then return end

    local bouldersFolder = mountainDecorations:FindFirstChild("Boulders")
    if not bouldersFolder then return end

    for _, boulder in pairs(bouldersFolder:GetChildren()) do
        if boulder:IsA("Model") and not BoulderData[boulder] then
            CreateBoulderUI(boulder)
        end
    end
end

local function UpdateAllBoulders()
    if not ESP_ENABLED then return end

    local player = Players.LocalPlayer
    if not player then return end
    local character = player.Character
    if not character then return end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    for boulder, data in pairs(BoulderData) do
        if not boulder or not boulder.Parent then
            BoulderData[boulder] = nil
        elseif not boulder:IsA("Model") then
            BoulderData[boulder] = nil
        else
            local hp    = boulder:GetAttribute("HP") or 100
            local maxHP = boulder:GetAttribute("MaxHP") or 100

            if hp ~= data.LastHP or maxHP ~= data.LastMaxHP then
                data.HP.Text = '<font color="'..GetHealthColor(hp/maxHP)..'">'..hp..'</font>/'..maxHP..' HP'
                data.LastHP = hp
                data.LastMaxHP = maxHP
            end

            local part = boulder:FindFirstChild("PrimaryPart") or boulder:FindFirstChildWhichIsA("BasePart")
            if part then
                local dist = math.floor((rootPart.Position - part.Position).Magnitude)
                data.Dist.Text = "Distance: "..dist.." Studs"

                local newSize = GetTextSize(dist)
                if math.abs(newSize - data.LastSize) > 0.1 then
                    data.HP.TextSize = newSize
                    data.Name.TextSize = newSize
                    data.Dist.TextSize = newSize
                    local s = newSize + 2
                    data.HP.Size = UDim2.new(1, 0, 0, s)
                    data.Name.Size = UDim2.new(1, 0, 0, s)
                    data.Dist.Size = UDim2.new(1, 0, 0, s)
                    data.LastSize = newSize
                end

                local newPad = GetPaddingSize(dist)
                if math.abs(newPad - data.LastPad) > 0.1 then
                    data.Layout.Padding = UDim.new(0, newPad)
                    data.LastPad = newPad
                end
            end

            local name   = boulder.Name
            local rarity = boulder:GetAttribute("Rarity") or "Common"
            local colorData = BoulderColors[boulder.Name]
            local hex = colorData and colorData[2] or "rgb(128,128,128)"

            if data.LastName ~= name or data.LastRarity ~= rarity then
                data.Name.Text = '<font color="'..hex..'">'..name..'</font> ('..rarity..')'
                data.LastName = name
                data.LastRarity = rarity
            end
        end
    end
end

local function InitAllBoulders()
    if not ESP_ENABLED then return end

    local mountainDecorations = workspace:FindFirstChild("MountainDecorations")
    if not mountainDecorations then return end

    local bouldersFolder = mountainDecorations:FindFirstChild("Boulders")
    if not bouldersFolder then return end

    for _, boulder in pairs(bouldersFolder:GetChildren()) do
        if boulder:IsA("Model") and not BoulderData[boulder] then
            CreateBoulderUI(boulder)
        end
    end
end

local function StartESP()
    ESP_ENABLED = true

    InitAllBoulders()

    if espConnection then
        pcall(function() espConnection:Disconnect() end)
    end
    if espSteppedConn then
        pcall(function() espSteppedConn:Disconnect() end)
    end

    espConnection = RunService.Heartbeat:Connect(UpdateAllBoulders)
    espSteppedConn = RunService.Stepped:Connect(CheckForNewBoulders)

    -- Отслеживаем позднее появление папок
    workspace.ChildAdded:Connect(function(child)
        if ESP_ENABLED and child.Name == "MountainDecorations" then
            task.wait(0.5)
            InitAllBoulders()
        end
    end)
end

local function StopESP()
    ESP_ENABLED = false

    if espConnection then
        pcall(function() espConnection:Disconnect() end)
        espConnection = nil
    end
    if espSteppedConn then
        pcall(function() espSteppedConn:Disconnect() end)
        espSteppedConn = nil
    end

    DestroyAllESP()
end

