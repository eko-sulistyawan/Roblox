-- ===================== Noclip =====================
local function startNoclip()
    pcall(function() Noclipping:Disconnect() end)
    Clip = false
    task.wait(0.1)
    NoclipParts = {}
    Noclipping = RunService.Stepped:Connect(function()
        if Clip == false and LocalPlayer.Character ~= nil then
            for _, child in pairs(LocalPlayer.Character:GetDescendants()) do
                if child:IsA("BasePart") and child.CanCollide == true then
                    child.CanCollide = false
                    NoclipParts[child] = true
                end
            end
        end
    end)
end

local function stopNoclip()
    pcall(function() Noclipping:Disconnect() end)
    Noclipping = nil
    Clip = true
    task.wait(0.1)
    for child, _ in pairs(NoclipParts) do
        if typeof(child) == "Instance" and child:IsA("BasePart") and child.Parent then
            child.CanCollide = true
        end
    end
    NoclipParts = {}
end

-- ===================== Animations =====================
local function disableAnimations()
    if not Character then return end
    local animate = Character:FindFirstChild("Animate")
    if animate then
        originalAnimate = animate
        animate.Disabled = true
    end
    if Humanoid then
        local animator = Humanoid:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                track:Stop()
            end
        end
        Humanoid.WalkSpeed = 0
        Humanoid.JumpPower = 0
    end
end

local function enableAnimations()
    if originalAnimate and originalAnimate.Parent then
        originalAnimate.Disabled = false
    end
    originalAnimate = nil
end

local function anchorPlayer(anchor)
    if not HumanoidRootPart then return end
    HumanoidRootPart.Anchored = anchor
    if anchor then
        HumanoidRootPart.AssemblyLinearVelocity   = Vector3.new(0, 0, 0)
        HumanoidRootPart.AssemblyAngularVelocity  = Vector3.new(0, 0, 0)
    end
end

local function faceBackDown()
    if not HumanoidRootPart then return end
    local pos = HumanoidRootPart.Position
    HumanoidRootPart.CFrame = CFrame.lookAt(pos, pos + Vector3.new(0, 1, 0), Vector3.new(0, 0, 1))
end

-- ===================== Halloween =====================
local function getTargetItems()
    local targetFolder = workspace:FindFirstChild("HalloweenEncounters")
    if not targetFolder then return {} end
    local items = {}
    for _, child in ipairs(targetFolder:GetChildren()) do
        for _, name in ipairs(TARGET_NAMES) do
            if child.Name == name then
                table.insert(items, child)
                break
            end
        end
    end
    return items
end

local function getBasePart(item)
    if item:IsA("BasePart") then return item
    elseif item:IsA("Model") then return item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart") end
    return nil
end

local function stopMovement()
    if alignPosition    then alignPosition:Destroy()    alignPosition = nil    end
    if alignOrientation then alignOrientation:Destroy() alignOrientation = nil end
    if alignAttachment  then alignAttachment:Destroy()  alignAttachment = nil  end
end

local function moveToPosition(position)
    if not HumanoidRootPart or not HumanoidRootPart.Parent then return end
    stopMovement()

    alignAttachment = Instance.new("Attachment")
    alignAttachment.Parent = HumanoidRootPart

    alignPosition = Instance.new("AlignPosition")
    alignPosition.Attachment0 = alignAttachment
    alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
    alignPosition.Position = position
    alignPosition.MaxForce = math.huge
    alignPosition.MaxVelocity = SPEED
    alignPosition.Responsiveness = RESPONSIVENESS
    alignPosition.ApplyAtCenterOfMass = true
    alignPosition.Parent = HumanoidRootPart

    alignOrientation = Instance.new("AlignOrientation")
    alignOrientation.Attachment0 = alignAttachment
    alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOrientation.CFrame = CFrame.lookAt(Vector3.zero, Vector3.new(0, 1, 0), Vector3.new(0, 0, 1))
    alignOrientation.MaxTorque = math.huge
    alignOrientation.Responsiveness = RESPONSIVENESS
    alignOrientation.Parent = HumanoidRootPart
end

local function waitForArrival(targetPos)
    while isRunning do
        if not HumanoidRootPart then break end
        if (targetPos - HumanoidRootPart.Position).Magnitude < 2 then break end
        task.wait(0.05)
    end
end

local function getNearestItem(items)
    if not HumanoidRootPart then return nil end
    local playerPos = HumanoidRootPart.Position
    local nearestItem, nearestPart, nearestDistance = nil, nil, math.huge
    for _, item in ipairs(items) do
        if not processedItems[item] then
            local basePart = getBasePart(item)
            if basePart then
                local distance = (basePart.Position - playerPos).Magnitude
                if distance < nearestDistance then
                    nearestDistance = distance
                    nearestItem = item
                    nearestPart = basePart
                end
            end
        end
    end
    return nearestItem, nearestPart
end

local function triggerDigRequest(itemPart)
    if not itemPart then return end

    local pickaxe = getEquippedPickaxe() or "The Event Horizon"
    local args = { pickaxe, itemPart.Position, itemPart }

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local digRequest = remotes:FindFirstChild("DigRequest")
        if digRequest then
            pcall(function() digRequest:FireServer(unpack(args)) end)
        end
    end
end

local function halloweenLoop()
    while isRunning do
        local items = getTargetItems()
        local foundNew = false
        local nearestItem, nearestPart = getNearestItem(items)

        if nearestItem and nearestPart then
            foundNew = true
            local targetPos = nearestPart.Position + Vector3.new(0, OFFSET_Y, 0)
            local distance = (targetPos - HumanoidRootPart.Position).Magnitude

            if distance <= DIG_DISTANCE then
                anchorPlayer(true); faceBackDown(); task.wait(0.1)
                triggerDigRequest(nearestPart); task.wait(0.5)
                processedItems[nearestItem] = true
            else
                anchorPlayer(false)
                moveToPosition(targetPos)
                waitForArrival(targetPos)
                stopMovement()
                if HumanoidRootPart then HumanoidRootPart.CFrame = CFrame.new(targetPos) end
                anchorPlayer(true); faceBackDown()
                if not isRunning then break end
                task.wait(0.1)
                triggerDigRequest(nearestPart)
                task.wait(0.1)
                processedItems[nearestItem] = true
            end
        end

        if not foundNew then
            anchorPlayer(true); faceBackDown(); task.wait(CHECK_INTERVAL)
        else
            task.wait(0.5)
        end
    end
    stopMovement()
    anchorPlayer(false)
end

-- ===================== Boulder =====================
local function getBoulderFolder()
    local current = workspace
    for _, seg in ipairs(BOULDER_FOLDER_PATH) do
        current = current:FindFirstChild(seg)
        if not current then return nil end
    end
    return current
end

local function isBoulderSelected(name)
    return BOULDER_NAMES[name] == true
end

local function getBoulderModels()
    local folder = getBoulderFolder()
    if not folder then return {} end
    local models, seen = {}, {}
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("Model") and isBoulderSelected(child.Name) then
            if not seen[child] then
                seen[child] = true
                table.insert(models, child)
            end
        end
    end
    return models
end

local function getBoulderCells(model)
    local cells = {}
    for _, part in ipairs(model:GetChildren()) do
        if part:IsA("BasePart") and part.Name:match("^" .. model.Name .. "_cell") then
            table.insert(cells, part)
        end
    end
    return cells
end

local function getBoulderCenter(model)
    local cells = getBoulderCells(model)
    if #cells == 0 then return nil end
    local sum = Vector3.new(0, 0, 0)
    for _, cell in ipairs(cells) do sum = sum + cell.Position end
    return sum / #cells
end

local function boulderHasHP(model)
    local hp = model:GetAttribute("HP")
    if hp == nil then hp = model:GetAttribute("Hp") end
    if hp == nil then hp = model:GetAttribute("hp") end
    return hp
end

